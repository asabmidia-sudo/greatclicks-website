# GHL inbound webhook URL for quiz submissions.
# Server-side only. Do NOT prefix with VITE_ — this must never ship in client JS.
# The Edge function api/quiz-submit.ts reads this and relays validated payloads.
GHL_QUIZ_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...

# Meta (Facebook) Pixel ID. Client-side, must be VITE_ prefixed.
# Used by src/lib/metaPixel.ts to load the pixel script and track PageView, Lead, InitiateCheckout.
VITE_META_PIXEL_ID=515330902899700

# Public GHL calendar URL. Leave blank until the direct booking calendar is ready.
VITE_SYSTEMS_REVIEW_BOOKING_URL=
